include .env

create-backup:
	@echo "Creating backup directory"
	@mkdir -p ./src/file
	@echo "Creating backup from external database"
	@docker run --rm -v "${PWD}:/app" -w /app \
		-e PGPASSWORD=${DATABASE_PASSWORD} \
		postgres:17 \
		bash -c "pg_dump --host=${DATABASE_HOST} --port=${DATABASE_PORT} --username=${DATABASE_USER} --dbname=${DATABASE_NAME} $$(echo '${DATABASE_EXCLUDE_TABLES_DATA}' | tr ',' '\n' | sed 's/^ *//;s/ *$$//' | grep -v '^$$' | sed 's/^/--exclude-table-data=/' | tr '\n' ' ') > /app/src/file/dump.sql"
	@echo "Backup created, uploading to Supabase"
	@docker run --rm -v "${PWD}:/app" -w /app --env-file .env node:22 \
		/bin/sh -c "yarn install && node src/index.js"
	@echo "Cleaning up backup file"
	@rm -f ./src/file/dump.sql
	@echo "Backup uploaded to Supabase, all jobs done."

clean:
	@echo "Cleaning up backup file"
	@rm -f ./src/file/dump.sql